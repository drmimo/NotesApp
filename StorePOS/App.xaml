<Application x:Class="StorePOS.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Dark Mode Colors -->
            <Color x:Key="DarkBackgroundColor">#1E1E1E</Color>
            <Color x:Key="DarkSurfaceColor">#2D2D2D</Color>
            <Color x:Key="DarkTextColor">#FFFFFF</Color>
            <Color x:Key="DarkSecondaryTextColor">#B0B0B0</Color>
            <Color x:Key="DarkAccentColor">#4CAF50</Color>
            <Color x:Key="DarkErrorColor">#F44336</Color>

            <!-- Light Mode Colors -->
            <Color x:Key="LightBackgroundColor">#F5F5F5</Color>
            <Color x:Key="LightSurfaceColor">#FFFFFF</Color>
            <Color x:Key="LightTextColor">#212121</Color>
            <Color x:Key="LightSecondaryTextColor">#757575</Color>
            <Color x:Key="LightAccentColor">#388E3C</Color>
            <Color x:Key="LightErrorColor">#D32F2F</Color>

            <!-- Default (Dark) Brushes -->
            <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource DarkBackgroundColor}"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource DarkSurfaceColor}"/>
            <SolidColorBrush x:Key="TextBrush" Color="{StaticResource DarkTextColor}"/>
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource DarkSecondaryTextColor}"/>
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource DarkAccentColor}"/>
            <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource DarkErrorColor}"/>

            <!-- Font Sizes for 14' screen -->
            <sys:Double x:Key="SmallFontSize" xmlns:sys="clr-namespace:System;assembly=System.Runtime">14</sys:Double>
            <sys:Double x:Key="NormalFontSize" xmlns:sys="clr-namespace:System;assembly=System.Runtime">16</sys:Double>
            <sys:Double x:Key="MediumFontSize" xmlns:sys="clr-namespace:System;assembly=System.Runtime">20</sys:Double>
            <sys:Double x:Key="LargeFontSize" xmlns:sys="clr-namespace:System;assembly=System.Runtime">28</sys:Double>
            <sys:Double x:Key="XLargeFontSize" xmlns:sys="clr-namespace:System;assembly=System.Runtime">36</sys:Double>
            <sys:Double x:Key="QuantityPriceFontSize" xmlns:sys="clr-namespace:System;assembly=System.Runtime">22</sys:Double>
            <sys:Double x:Key="TotalFontSize" xmlns:sys="clr-namespace:System;assembly=System.Runtime">42</sys:Double>

            <!-- Control Styles -->
            <Style TargetType="Button">
                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="{StaticResource NormalFontSize}"/>
                <Setter Property="Padding" Value="15,8"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Opacity" Value="0.9"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.5"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="FontSize" Value="{StaticResource NormalFontSize}"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="BorderBrush" Value="{StaticResource SecondaryTextBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <Style TargetType="ListBoxItem">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="Padding" Value="10"/>
                <Setter Property="FontSize" Value="{StaticResource NormalFontSize}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
